class ChessUi
{
    SLOT(void newGame(QString mode, bool asWhite, int skillLevel, int timeControlMin))
    SLOT(void playerMove(QString uciMove))
    SLOT(void typedMove(QString text))
    SLOT(void undoMove())
    SLOT(void requestHint())
    SLOT(void resign())
    SLOT(void agreeDraw())
    SLOT(void changeSkill(int level))
    SLOT(void setEnginePath(QString path))

    PROP(QString mode="engine" READONLY)
    PROP(QString fen="" READONLY)
    PROP(QString legalMoves="" READONLY)
    PROP(QString legalSans="" READONLY)
    PROP(QString gameState="starting" READONLY)
    PROP(QString status="" READONLY)
    PROP(QString lastMove="" READONLY)
    PROP(QString sanRows="" READONLY)
    PROP(QString engineLog="" READONLY)
    PROP(QString evalText="" READONLY)
    PROP(int evalCp=0 READONLY)
    PROP(QString engineName="" READONLY)
    PROP(bool engineReady=false READONLY)
    PROP(bool playerIsWhite=true READONLY)
    PROP(bool inCheck=false READONLY)
    PROP(int skill=4 READONLY)
    PROP(int clockWhiteMs=600000 READONLY)
    PROP(int clockBlackMs=600000 READONLY)
    PROP(QString material="" READONLY)

    SIGNAL(hintReady(QString uciMove))
}
